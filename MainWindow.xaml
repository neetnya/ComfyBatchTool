<Window x:Class="ComfyBatchTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComfyUI 批量提示词工具" Height="680" Width="1050"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.5*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：只保留地址 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="ComfyUI 地址:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtBaseUrl" Width="260" Margin="8,0" Padding="4"
                     Text="http://127.0.0.1:8188" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="TxtStatus" Text="就绪" VerticalAlignment="Center" 
                       Margin="16,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- 提示词队列区 -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="正向提示词队列（每行一组，按顺序提交；自动折行不算新组）"
                       Foreground="#555" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtPromptQueue" Grid.Row="1"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="14"
                     Padding="8" Text=""/>
        </Grid>

        <!-- 底部控制与日志区 -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="每组生成数量:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtCount" Grid.Column="1" Width="80" Margin="8,0,24,0" Padding="4"
                     VerticalContentAlignment="Center" Text="1"/>
            
            <Button Grid.Column="2" Content="开始批量排队" Click="BtnRun_Click" 
                    HorizontalAlignment="Right" Padding="24,8" Margin="0,0,12,0"
                    Background="#2D7D46" Foreground="White" FontWeight="Bold"/>
            <Button Grid.Column="3" Content="停止" Click="BtnStop_Click" 
                    Padding="24,8" Background="#E0E0E0"/>
        </Grid>

        <!-- 日志区 -->
        <GroupBox Grid.Row="4" Header="运行日志" Padding="4" Margin="0,4,0,0">
            <TextBox x:Name="TxtLog" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                     BorderThickness="0" Background="Transparent" Text=""/>
        </GroupBox>
    </Grid>
</Window>