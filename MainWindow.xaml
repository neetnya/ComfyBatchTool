<Window x:Class="ComfyBatchTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComfyUI 批量提示词工具" Height="760" Width="1120"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：只保留地址 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="ComfyUI 地址:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtBaseUrl" Width="260" Margin="8,0" Padding="4"
                     Text="http://127.0.0.1:8188" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="TxtStatus" Text="就绪" VerticalAlignment="Center"
                       Margin="16,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- 主体：左侧工作流列表 + 右侧提示词队列 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 工作流勾选区：只提交勾选的 JSON -->
            <GroupBox Grid.Column="0" Header="工作流列表" Padding="6,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="BtnSelectAll" Content="全选" Click="BtnSelectAll_Click"
                                Padding="10,2" Margin="0,0,6,0"/>
                        <Button x:Name="BtnSelectNone" Content="全不选" Click="BtnSelectNone_Click"
                                Padding="10,2" Margin="0,0,6,0"/>
                        <Button x:Name="BtnReloadWorkflows" Content="刷新" Click="BtnReloadWorkflows_Click"
                                Padding="10,2"/>
                    </StackPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="Gray" FontSize="11"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="拖入 .json 可添加"/>
                        <Button x:Name="BtnOpenWorkflowFolder" Grid.Column="1" Content="打开目录"
                                Click="BtnOpenWorkflowFolder_Click" Padding="8,2" FontSize="11"
                                Margin="6,0,0,0" ToolTip="在资源管理器中打开 api 工作流目录"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  AllowDrop="True"
                                  PreviewDragOver="WorkflowList_DragOver"
                                  PreviewDrop="WorkflowList_Drop">
                        <ItemsControl x:Name="LstWorkflows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              ToolTip="{Binding Path}"
                                              Padding="4,5" Margin="0,0,0,1" MinHeight="26"
                                              VerticalContentAlignment="Center">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#EAF1FA"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>

            <!-- 提示词队列区（支持拖入一个或多个 txt） -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="正向提示词队列"
                           Foreground="#555" Margin="0,0,0,6"/>

                <TextBox x:Name="TxtPromptQueue" Grid.Row="1"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" FontFamily="Consolas" FontSize="14"
                         Padding="8" Text="" AllowDrop="True"
                         PreviewDragOver="Prompt_PreviewDragOver"
                         PreviewDrop="Prompt_PreviewDrop"/>

                <!-- 控制区 -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="每组生成数量:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtCount" Grid.Column="1" Width="80" Margin="8,0,24,0" Padding="4"
                             VerticalContentAlignment="Center" Text="1"/>

                    <CheckBox x:Name="ChkLockSeed" Grid.Column="2" VerticalAlignment="Center"
                              Content="🔒 锁定 seed"
                              ToolTip="勾选后：同一条提示词提交到所有工作流时使用同一个 seed，方便对比不同工作流；不同提示词之间仍然各自随机。"/>

                    <CheckBox x:Name="ChkGlobalLockSeed" Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center"
                              Content="🌐 全局锁定 seed"
                              Checked="ChkGlobalLockSeed_Changed" Unchecked="ChkGlobalLockSeed_Changed"
                              ToolTip="勾选后：点击「开始批量排队」时才生成一个 seed，本批次内所有提示词、所有工作流共用这一个 seed。与「锁定 seed」同时勾选时以本项为准；每组生成数量大于 1 时会得到相同的图。"/>

                    <Button x:Name="BtnRun" Grid.Column="4" Content="开始批量排队" Click="BtnRun_Click"
                            HorizontalAlignment="Right" Padding="24,8"
                            Background="#2D7D46" Foreground="White" FontWeight="Bold"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 日志区（只显示提交完成信息，高度收窄） -->
        <GroupBox Grid.Row="2" Header="运行日志" Padding="4" Margin="0,4,0,0"
                  Height="72" VerticalAlignment="Top">
            <TextBox x:Name="TxtLog" IsReadOnly="True" Height="24"
                     VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                     FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                     BorderThickness="0" Background="Transparent" Text="" IsTabStop="False"/>
        </GroupBox>
    </Grid>
</Window>
