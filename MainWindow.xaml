<Window x:Class="ComfyBatchTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComfyUI 批量提示词工具" Height="740" Width="1050"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：只保留地址 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="ComfyUI 地址:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtBaseUrl" Width="260" Margin="8,0" Padding="4"
                     Text="http://127.0.0.1:8188" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="TxtStatus" Text="就绪" VerticalAlignment="Center"
                       Margin="16,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- 工作流勾选区：只提交勾选的 JSON -->
        <GroupBox Grid.Row="1" Margin="0,0,0,12" Padding="6,4"
                  Header="启用的工作流（只有勾选的 JSON 会被提交）">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Top" Margin="10,0,0,0">
                    <Button x:Name="BtnSelectAll" Content="全选" Click="BtnSelectAll_Click"
                            Padding="10,2" Margin="0,0,6,0"/>
                    <Button x:Name="BtnSelectNone" Content="全不选" Click="BtnSelectNone_Click"
                            Padding="10,2"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" MaxHeight="92">
                    <ItemsControl x:Name="LstWorkflows">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding FileName}"
                                          ToolTip="{Binding Path}"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          Margin="0,3,18,3" VerticalContentAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </GroupBox>

        <!-- 提示词队列区（支持拖入一个或多个 txt） -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="正向提示词队列（每行一组，按顺序提交；可直接拖入一个或多个 .txt 文件）"
                       Foreground="#555" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtPromptQueue" Grid.Row="1"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="14"
                     Padding="8" Text="" AllowDrop="True"
                     PreviewDragOver="Prompt_PreviewDragOver"
                     PreviewDrop="Prompt_PreviewDrop"/>
        </Grid>

        <!-- 底部控制区 -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="每组生成数量:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtCount" Grid.Column="1" Width="80" Margin="8,0,24,0" Padding="4"
                     VerticalContentAlignment="Center" Text="1"/>

            <CheckBox x:Name="ChkLockSeed" Grid.Column="2" VerticalAlignment="Center"
                      Content="🔒 锁定 seed（同组提示词在多个工作流中保持一致）"
                      ToolTip="勾选后：同一条提示词提交到所有工作流时使用同一个 seed，方便对比不同工作流；不同提示词之间仍然各自随机。"/>

            <Button x:Name="BtnRun" Grid.Column="3" Content="开始批量排队" Click="BtnRun_Click"
                    HorizontalAlignment="Right" Padding="24,8"
                    Background="#2D7D46" Foreground="White" FontWeight="Bold"/>
        </Grid>

        <!-- 日志区（只显示提交完成信息，高度收窄） -->
        <GroupBox Grid.Row="4" Header="运行日志" Padding="4" Margin="0,4,0,0"
                  Height="72" VerticalAlignment="Top">
            <TextBox x:Name="TxtLog" IsReadOnly="True" Height="24"
                     VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                     FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                     BorderThickness="0" Background="Transparent" Text="" IsTabStop="False"/>
        </GroupBox>
    </Grid>
</Window>
